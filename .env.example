# ---------------------------------------------------------------------------
# Clerk -- handles all OAuth for the MCP server.
# Get these from the Clerk Dashboard >> API keys.
# ---------------------------------------------------------------------------
# Placeholders are deliberately not in real key format -- a realistic-looking
# dummy trips GitHub push protection, since sk_test_ collides with Stripe's
# prefix. Paste your actual values in .env.local, which is gitignored.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=<your-clerk-publishable-key>
CLERK_SECRET_KEY=<your-clerk-secret-key>

# ---------------------------------------------------------------------------
# Your app. Replace with whatever your service layer actually needs --
# a database URL, an internal API base URL, a service token, etc.
# The starter ships with an in-memory stub so it runs before you wire anything.
# ---------------------------------------------------------------------------
APP_API_BASE_URL=http://localhost:4000
APP_API_TOKEN=

# ---------------------------------------------------------------------------
# Public URL of this server. Used in the OAuth metadata documents, so it has to
# be the URL clients actually reach you on. On Vercel this is set for you.
# ---------------------------------------------------------------------------
# SERVER_HOST=https://mcp.yourapp.com
